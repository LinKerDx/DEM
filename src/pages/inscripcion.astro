---
import Base from '../DEM/Base.astro';
import Formulario from '../Inscripcion/Formulario.astro';
import { sitio } from '../config/sitio';

const endpoint = `https://formsubmit.co/ajax/${sitio.formsubmitToken}`;
---

<Base
	title={`Inscripción · ${sitio.nombreCompleto}`}
	description={`Inscripción · ${sitio.descripcion}`}
>
	<Formulario endpoint={endpoint} />
</Base>